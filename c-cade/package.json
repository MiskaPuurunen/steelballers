{
  "name": "c-cade",
  "version": "1.0.0",
  "description": "A terminal minigame arcade for developers waiting on their AI coding agent. Your AI is thinking. You're playing.",
  "type": "module",
  "bin": {
    "c-cade": "dist/cli/index.js",
    "vibebreak": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "smoke": "npm run build && python3 scripts/pty-smoke.py",
    "demo:lan": "npm run build && node scripts/lan-demo.mjs",
    "screens:lan": "tsx scripts/lan-screens.ts"
  },
  "keywords": [
    "cli",
    "terminal",
    "game",
    "arcade",
    "ascii",
    "claude-code",
    "ai",
    "developer-tools",
    "multiplayer",
    "lan",
    "party-game"
  ],
  "author": "Matei Stefan Crisan",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "wasmoon": "1.16.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
